{
  "name": "una-md-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "UNA.md Retail — configurable mobile shopping app (Kaufland/Auchan style) driven by JSON configuration, SQLite offline storage and API sync",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:mock": "node tools/mock-server.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate-config": "ts-node --project tsconfig.test.json tools/validate-config.ts",
    "check": "npm run typecheck && npm run validate-config && npm test"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "^57.0.15",
    "expo-constants": "^57.0.13",
    "expo-localization": "^57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "^57.0.1",
    "expo-status-bar": "^57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.7",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
