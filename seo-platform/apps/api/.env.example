# Платформа
DATABASE_URL=postgres://seo:seo@localhost:5432/seo
PORT=3000

# Учётный контур UNA.md
# mock   - локальная разработка без Oracle (документы никуда не уходят)
# oracle - вызовы пакетов PK_SEO_* в схеме UN4
UNA_MODE=mock
UNA_ORACLE_DSN=db.internal:1521/UNASYS
UNA_ORACLE_USER=SEO_AI_BOT
# Пароль берётся из Vault/Oracle Wallet, в репозитории и в плейбуках его нет
UNA_ORACLE_PASSWORD=

# Разработка без внешней базы: встроенный Postgres в WASM, миграции
# накатываются автоматически. Данные живут, пока живёт процесс.
# DATABASE_URL=pglite

# Раннер AI-сессий. off (по умолчанию) — запуски копятся в очереди и никто
# их не исполняет; claude — очередь обрабатывается через Messages API.
# Исполнение плейбука тратит деньги, поэтому включается осознанно.
RUNNER=off
# Ключ берётся из окружения SDK: ANTHROPIC_API_KEY либо профиль ant auth login.
# ANTHROPIC_API_KEY=

# Разрешить запуск, когда часть инструментов плейбука не реализована.
# По умолчанию такой запуск отклоняется: без доступа к данным сессия
# выдаст правдоподобный вымысел вместо результата.
RUNNER_ALLOW_MISSING_TOOLS=false

# Планировщик расписаний. off (по умолчанию) — расписания хранятся, но не
# срабатывают; on — проверка раз в минуту, срабатывания ставятся в очередь.
SCHEDULER=off

# Коннекторы. Без ключа инструмент не регистрируется, и плейбук, которому он
# нужен, будет отклонён — это намеренно: подключить наполовину означает
# получить выдуманные позиции вместо реальных.
# SERP_API_KEY=
# SERP_ENDPOINT=https://google.serper.dev/search
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# GSC_SITE_URL=sc-domain:una.md
