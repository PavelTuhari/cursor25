# Every config key can be overridden by an environment variable.
# The name is the JSON path upper-cased with dots replaced by double underscores,
# prefixed with EFACT__ - e.g. sfs.password becomes EFACT__SFS__PASSWORD.
#
# Secrets belong here (or in the platform secret store), never in service.config.json.

EFACT__SFS__USERNAME=supplier
EFACT__SFS__PASSWORD=change-me
EFACT__SFS__ENDPOINT=https://efactura-api.sfs.md/Service.svc

EFACT__ORACLE__CONNECTSTRING=db-host:1521/ERPPDB
EFACT__ORACLE__USER=EFACTURA
EFACT__ORACLE__PASSWORD=change-me

# signing.mode: none | pkcs12 | pkiserver
EFACT__SIGNING__MODE=pkcs12
EFACT__SIGNING__PKCS12__FILE=/etc/una-efactura/certs/company.p12
EFACT__SIGNING__PKCS12__PASSPHRASE=change-me

EFACT__SERVICE__TENANTID=una-md
EFACT__SERVICE__HTTP__PORT=8090
EFACT__SERVICE__APITOKEN=change-me-long-random

# --- Incoming invoices (the wallet) ----------------------------------------
# Turning this on lets the service act for other companies, using credentials
# they entrust to it. Those credentials are stored sealed, so the key below is
# required and the service refuses to start without it.
#
#   openssl rand -base64 32
#
EFACT__INBOX__ENABLED=true
EFACT__CRYPTO__KEY=
EFACT__CRYPTO__CONSENTVERSION=2026-08-25

# Polling floor is one minute; 15 is the working default.
EFACT__INBOX__POLLINTERVALMS=900000
EFACT__INBOX__BACKFILLMONTHS=12
