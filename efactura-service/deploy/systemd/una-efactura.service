# /etc/systemd/system/una-efactura.service
#
#   sudo cp deploy/systemd/una-efactura.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now una-efactura
#   journalctl -u una-efactura -f
[Unit]
Description=UNA e-Factura integration service
Documentation=file:/opt/una-efactura/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=efactura
Group=efactura
WorkingDirectory=/opt/una-efactura
EnvironmentFile=/etc/una-efactura/efactura.env
ExecStart=/usr/bin/node dist/src/main.js
Restart=on-failure
RestartSec=10
# Give an in-flight tick time to finish before the process is killed.
KillSignal=SIGTERM
TimeoutStopSec=45

# The service reads one certificate and talks to two hosts; nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/una-efactura
StateDirectory=una-efactura

[Install]
WantedBy=multi-user.target
